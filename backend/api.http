###############################################
# CAREERS
###############################################

### Get All Jobs
GET {{baseUrl}}/careers?page=1&limit=10

### Get Open Jobs
GET {{baseUrl}}/careers?status=open

### Get Jobs by Department
GET {{baseUrl}}/careers?department=Engineering

### Get Job by ID
GET {{baseUrl}}/careers/REPLACE_WITH_ID

### Get Job by Slug
GET {{baseUrl}}/careers/slug/senior-fullstack-developer

### Create Job
POST {{baseUrl}}/careers
Content-Type: application/json

{
  "jobTitle": "Senior Fullstack Developer",
  "slug": "senior-fullstack-developer",
  "department": "Engineering",
  "experience": "3-5 years",
  "employmentType": "full-time",
  "salary": "$80,000 - $100,000",
  "location": "Remote / New York",
  "description": "We are looking for a senior fullstack developer...",
  "responsibilities": ["Build scalable APIs", "Lead technical discussions", "Mentor juniors"],
  "requirements": ["3+ years Node.js", "React experience", "MongoDB knowledge"],
  "benefits": ["Health Insurance", "Flexible Hours", "Remote Work"],
  "vacancies": 2,
  "deadline": "2025-03-31",
  "status": "open"
}

### Update Job
PUT {{baseUrl}}/careers/REPLACE_WITH_ID
Content-Type: application/json

{
  "status": "open",
  "vacancies": 3
}

### Delete Job
DELETE {{baseUrl}}/careers/REPLACE_WITH_ID

###############################################
# JOB APPLICATIONS
###############################################

### Get All Applications
GET {{baseUrl}}/job-applications?page=1&limit=10

### Get Applications by Status
GET {{baseUrl}}/job-applications?status=new

### Get Applications for a Position
GET {{baseUrl}}/job-applications?position=developer

### Get Application by ID
GET {{baseUrl}}/job-applications/REPLACE_WITH_ID

### Submit Application
POST {{baseUrl}}/job-applications
Content-Type: application/json

{
  "name": "Alice Williams",
  "email": "alice@example.com",
  "phone": "+1 555 123 4567",
  "experience": "4 years",
  "currentCompany": "Old Corp",
  "currentSalary": "$70,000",
  "expectedSalary": "$90,000",
  "noticePeriod": "30 days",
  "appliedPosition": "Senior Fullstack Developer",
  "coverLetter": "I am excited to apply for this position...",
  "portfolioUrl": "https://alicewilliams.dev",
  "linkedinUrl": "https://linkedin.com/in/alicewilliams"
}

### Update Application Status
PATCH {{baseUrl}}/job-applications/REPLACE_WITH_ID/status
Content-Type: application/json

{
  "status": "shortlisted"
}

### Delete Application
DELETE {{baseUrl}}/job-applications/REPLACE_WITH_ID

