@baseUrl = http://localhost:5000/api

###############################################
# SETTINGS
###############################################

### Get Settings
GET {{baseUrl}}/settings

### Update Settings (JSON only fields)
PUT {{baseUrl}}/settings
Content-Type: application/json

{
  "websiteName": "My Company",
  "phone": "+1 234 567 8900",
  "whatsapp": "+1 234 567 8900",
  "email": "hello@mycompany.com",
  "address": "123 Main St, New York, NY 10001",
  "footer": "© 2025 My Company. All rights reserved.",
  "googleMap": "https://maps.google.com/maps?q=New+York",
  "socialLinks": {
    "facebook": "https://facebook.com/mycompany",
    "instagram": "https://instagram.com/mycompany",
    "twitter": "https://twitter.com/mycompany",
    "linkedin": "https://linkedin.com/company/mycompany",
    "youtube": "https://youtube.com/@mycompany"
  }
}

###############################################
# SEO SETTINGS
###############################################

### Get SEO Settings
GET {{baseUrl}}/seo

### Update SEO Settings
PUT {{baseUrl}}/seo
Content-Type: application/json

{
  "googleAnalytics": "G-XXXXXXXXXX",
  "googleTagManager": "GTM-XXXXXXX",
  "metaPixel": "1234567890",
  "headerScripts": "<script>/* header script */</script>",
  "footerScripts": "<script>/* footer script */</script>",
  "customCSS": "body { font-family: sans-serif; }",
  "customJS": "console.log('custom js');"
}

###############################################
# PAGES
###############################################

### Get All Pages
GET {{baseUrl}}/pages?page=1&limit=10&search=&sortField=createdAt&sortOrder=desc

### Get All Published Pages
GET {{baseUrl}}/pages?status=published

### Get Page by ID
GET {{baseUrl}}/pages/REPLACE_WITH_ID

### Get Page by Slug
GET {{baseUrl}}/pages/slug/home

### Create Page
POST {{baseUrl}}/pages
Content-Type: application/json

{
  "title": "About Us",
  "slug": "about-us",
  "content": "<p>Welcome to our company.</p>",
  "metaTitle": "About Us | My Company",
  "metaDescription": "Learn about our company, mission and team.",
  "canonicalUrl": "https://mycompany.com/about-us",
  "schemaJson": "{\"@type\": \"WebPage\"}",
  "status": "published"
}

### Update Page
PUT {{baseUrl}}/pages/REPLACE_WITH_ID
Content-Type: application/json

{
  "title": "About Us Updated",
  "status": "published"
}

### Delete Page
DELETE {{baseUrl}}/pages/REPLACE_WITH_ID

###############################################
# SERVICES
###############################################

### Get All Services
GET {{baseUrl}}/services?page=1&limit=10&sortField=createdAt&sortOrder=desc

### Get Featured Services
GET {{baseUrl}}/services?featured=true&status=published

### Get Service by ID
GET {{baseUrl}}/services/REPLACE_WITH_ID

### Get Service by Slug
# GET {{baseUrl}}/services/slug/web-development
GET {{baseUrl}}/services/slug/ai-driven-digital-marketing
### Create Service
POST {{baseUrl}}/services
Content-Type: application/json

{
  "title": "Web Development",
  "slug": "web-development",
  "shortDescription": "We build fast, responsive websites.",
  "overview": "Our web development services...",
  "mainContent": "<p>Full web development content here.</p>",
  "features": ["Responsive Design", "SEO Optimized", "Fast Loading"],
  "benefits": ["Increased Traffic", "Better Conversions"],
  "process": ["Discovery", "Design", "Development", "Launch"],
  "faq": [{"question": "How long does it take?", "answer": "4-8 weeks"}],
  "cta": {"heading": "Ready to Start?", "subheading": "Contact us today", "buttonText": "Get Started", "buttonLink": "/contact"},
  "metaTitle": "Web Development | My Company",
  "metaDescription": "Professional web development services.",
  "canonicalUrl": "https://mycompany.com/services/web-development",
  "schemaJson": "{\"@type\": \"Service\"}",
  "featured": true,
  "status": "published"
}

### Update Service
PUT {{baseUrl}}/services/REPLACE_WITH_ID
Content-Type: application/json

{
  "featured": true,
  "status": "published"
}

### Delete Service
DELETE {{baseUrl}}/services/REPLACE_WITH_ID

###############################################
# INDUSTRIES
###############################################

### Get All Industries
GET {{baseUrl}}/industries?page=1&limit=1

### Get Industry by ID
GET {{baseUrl}}/industries/REPLACE_WITH_ID

### Get Industry by Slug
GET {{baseUrl}}/industries/slug/foods-industry

### Create Industry
POST {{baseUrl}}/industries
Content-Type: application/json

{
  "title": "Healthcare",
  "slug": "healthcare",
  "overview": "Digital solutions for the healthcare industry.",
  "content": "<p>We serve healthcare providers...</p>",
  "benefits": ["HIPAA Compliant", "Secure Data", "24/7 Support"],
  "faq": [{"question": "Do you build HIPAA compliant apps?", "answer": "Yes, absolutely."}],
  "cta": {"heading": "Transform Your Healthcare Business", "buttonText": "Talk to Us", "buttonLink": "/contact"},
  "metaTitle": "Healthcare IT Solutions | My Company",
  "metaDescription": "We provide digital solutions for healthcare.",
  "status": "published"
}

### Update Industry
PUT {{baseUrl}}/industries/REPLACE_WITH_ID
Content-Type: application/json

{
  "status": "published"
}

### Delete Industry
DELETE {{baseUrl}}/industries/REPLACE_WITH_ID

###############################################
# BLOGS
###############################################

### Get All Blogs
GET {{baseUrl}}/blogs?page=1&limit=10&sortField=createdAt&sortOrder=desc

### Get Published Blogs
GET {{baseUrl}}/blogs?status=published

### Get Blogs by Category
GET {{baseUrl}}/blogs?category=Technology

### Search Blogs
GET {{baseUrl}}/blogs?search=nodejs

### Get Blog by ID
GET {{baseUrl}}/blogs/REPLACE_WITH_ID

### Get Blog by Slug (also increments views)
GET {{baseUrl}}/blogs/slug/getting-started-with-nodejs

### Create Blog
# POST {{baseUrl}}/blogs
# Content-Type: application/json

# {
#   "title": "Getting Started with Node.js",
#   "slug": "getting-started-with-nodejs",
#   "category": "Technology",
#   "tags": ["nodejs", "javascript", "backend"],
#   "excerpt": "A beginner's guide to Node.js development.",
#   "content": "<p>Node.js is a JavaScript runtime...</p>",
#   "author": "John Doe",
#   "publishedDate": "2025-01-15",
#   "metaTitle": "Getting Started with Node.js | Blog",
#   "metaDescription": "Learn Node.js from scratch.",
#   "canonicalUrl": "https://mycompany.com/blog/getting-started-with-nodejs",
#   "status": "published"
# }

### Create Blog with Images

POST http://localhost:5000/api/blogs
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="title"

Getting Started with Node.js
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="slug1"

getting-started-with-nodejs
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="category"

Technology
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="tags"

nodejs,javascript,backend
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="excerpt"

A beginner's guide to Node.js
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="content"

<p>Node.js is awesome.</p>
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="author"

John Doe
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="status"

published

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="featuredImage"; filename="featured.jpg"
Content-Type: image/jpeg

< C:\Users\PC\Desktop\featured.jpg

# ------WebKitFormBoundary7MA4YWxkTrZu0gW
# Content-Disposition: form-data; name="bannerImage"; filename="banner.jpg"
# Content-Type: image/jpeg

# < C:\Users\PC\Desktop\banner.jpg

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="gallery"; filename="img1.jpg"
Content-Type: image/jpeg

< C:\Users\PC\Desktop\img1.jpg

------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Update Blog
PUT {{baseUrl}}/blogs/REPLACE_WITH_ID
Content-Type: application/json

{
  "status": "published",
  "tags": ["nodejs", "javascript", "backend", "tutorial"]
}

### Delete Blog
DELETE {{baseUrl}}/blogs/REPLACE_WITH_ID

###############################################
# PROJECTS
###############################################

### Get All Projects
GET {{baseUrl}}/projects?page=1&limit=10

### Get Featured Projects
GET {{baseUrl}}/projects?featured=true

### Get Project by ID
GET {{baseUrl}}/projects/REPLACE_WITH_ID

### Get Project by Slug
GET {{baseUrl}}/projects/slug/ecommerce-platform

### Create Project
POST {{baseUrl}}/projects
Content-Type: application/json

{
  "title": "E-Commerce Platform",
  "slug": "ecommerce-platform",
  "clientName": "Acme Corp",
  "websiteUrl": "https://acme.com",
  "technology": ["React", "Node.js", "MongoDB", "Stripe"],
  "description": "A full-featured e-commerce platform...",
  "completionDate": "2024-12-01",
  "featured": true,
  "metaTitle": "E-Commerce Platform | Portfolio",
  "metaDescription": "See how we built the Acme e-commerce platform.",
  "status": "published"
}

### Update Project
PUT {{baseUrl}}/projects/REPLACE_WITH_ID
Content-Type: application/json

{
  "featured": true
}

### Delete Project
DELETE {{baseUrl}}/projects/REPLACE_WITH_ID

###############################################
# CASE STUDIES
###############################################

### Get All Case Studies
GET {{baseUrl}}/case-studies?page=1&limit=4

### Get Case Study by ID
GET {{baseUrl}}/case-studies/REPLACE_WITH_ID

### Get Case Study by Slug
GET {{baseUrl}}/case-studies/slug/acme-digital-transformation

### Create Case Study
POST {{baseUrl}}/case-studies
Content-Type: application/json

{
  "title": "Acme Digital Transformation",
  "slug": "acme-digital-transformation",
  "client": "Acme Corp",
  "industry": "Retail",
  "challenge": "Acme needed to modernize their legacy system...",
  "solution": "We built a cloud-based microservices architecture...",
  "result": "300% increase in performance, 50% cost reduction.",
  "metaTitle": "Acme Case Study | My Company",
  "metaDescription": "How we transformed Acme's digital infrastructure.",
  "status": "published"
}

### Update Case Study
PUT {{baseUrl}}/case-studies/REPLACE_WITH_ID
Content-Type: application/json

{
  "result": "350% increase in performance, 55% cost reduction."
}

### Delete Case Study
DELETE {{baseUrl}}/case-studies/REPLACE_WITH_ID

###############################################
# TEAM
###############################################

### Get All Team Members
GET {{baseUrl}}/team?page=1&limit=10&sortField=displayOrder&sortOrder=asc

### Search Team Members
GET {{baseUrl}}/team?search=designer

### Get Team Member by ID
GET {{baseUrl}}/team/REPLACE_WITH_ID

### Create Team Member
POST {{baseUrl}}/team
Content-Type: application/json

{
  "name": "Jane Smith",
  "designation": "Lead Designer",
  "bio": "Jane has 10 years of design experience...",
  "experience": "10 years",
  "skills": ["Figma", "Adobe XD", "UI/UX", "Branding"],
  "linkedin": "https://linkedin.com/in/janesmith",
  "instagram": "https://instagram.com/janesmith",
  "twitter": "https://twitter.com/janesmith",
  "email": "jane@mycompany.com",
  "displayOrder": 1
}

### Update Team Member
PUT {{baseUrl}}/team/REPLACE_WITH_ID
Content-Type: application/json

{
  "designation": "Senior Lead Designer",
  "displayOrder": 1
}

### Delete Team Member
DELETE {{baseUrl}}/team/REPLACE_WITH_ID

